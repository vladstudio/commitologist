{
  "name": "commitologist",
  "displayName": "Commitologist",
  "description": "Generate commit messages using Tetra",
  "version": "0.3.0",
  "publisher": "vladstudio",
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "commit",
    "commit-message",
    "productivity",
    "source-control"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vladstudio/commitologist.git"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:commitologist.generateMessage"
  ],
  "contributes": {
    "configuration": {
      "title": "Commitologist",
      "properties": {
        "commitologist.commandName": {
          "type": "string",
          "default": "Commit message",
          "description": "Name of the Tetra transform command to invoke."
        }
      }
    },
    "commands": [
      {
        "command": "commitologist.generateMessage",
        "title": "Commitologist: Generate Commit Message",
        "icon": {
          "light": "icon.svg",
          "dark": "icon-dark.svg"
        }
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "commitologist.generateMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "commitologist.generateMessage",
          "when": "scmProvider == git"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node16",
    "typecheck": "tsc -p ./ --noEmit",
    "watch": "bun run build --watch",
    "clean": "rm -rf dist",
    "test": "bun test",
    "vscode:prepublish": "bun run build",
    "compile": "tsc -p ./",
    "lint": "biome check src",
    "lint:fix": "biome check --fix src",
    "format": "biome format --write src"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.6",
    "@types/vscode": "1.102.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "extensionDependencies": [
    "vscode.git"
  ]
}
